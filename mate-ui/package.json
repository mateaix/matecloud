{
  "name": "mate-ui",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "pnpm --filter @matecloud/admin dev",
    "dev:all": "pnpm --parallel -r dev",
    "dev:desktop": "pnpm --filter @matecloud/desktop dev",
    "dev:docs": "pnpm --filter @matecloud/docs dev",
    "build:docs": "pnpm --filter @matecloud/docs build",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.9.6",
    "typescript": "^6.0.3"
  }
}
